":1449,"start":89.3625,"end":90.08250000000001},{"id":"1-59","paragraph":29,"text":"“She really has that hat.”","charStart":1450,"charEnd":1476,"start":90.45,"end":91.69500000000001},{"id":"1-60","paragraph":30,"text":"The phone lights up.","charStart":1478,"charEnd":1498,"start":92.0125,"end":92.89500000000001},{"id":"1-61","paragraph":30,"text":"Maya looks at the name.","charStart":1499,"charEnd":1522,"start":93.1875,"end":94.22},{"id":"1-62","paragraph":30,"text":"This time she picks it up.","charStart":1523,"charEnd":1549,"start":94.525,"end":95.63250000000001},{"id":"1-63","paragraph":31,"text":"“Work again?”","charStart":1551,"charEnd":1564,"start":96,"end":96.62},{"id":"1-64","paragraph":32,"text":"“Yes.","charStart":1566,"charEnd":1571,"start":97,"end":97.3575},{"id":"1-65","paragraph":32,"text":"They want a new picture on somebody else's page.","charStart":1572,"charEnd":1620,"start":97.725,"end":99.92},{"id":"1-66","paragraph":32,"text":"Mine can wait.”","charStart":1621,"charEnd":1636,"start":100.2125,"end":100.97},{"id":"1-67","paragraph":33,"text":"She closes the book on the two people and their one coat.","charStart":1638,"charEnd":1695,"start":101.2875,"end":104.22},{"id":"1-68","paragraph":34,"text":"We go back to the kitchen.","charStart":1697,"charEnd":1723,"start":104.5125,"end":105.62},{"id":"1-69","paragraph":35,"text":"“Tea?” she asks.","charStart":1725,"charEnd":1741,"start":105.9875,"end":106.845},{"id":"1-70","paragraph":36,"text":"“Yes, please.”","charStart":1743,"charEnd":1757,"start":107.2125,"end":108.0075},{"id":"1-71","paragraph":37,"text":"“Milk?”","charStart":1759,"charEnd":1766,"start":108.3875,"end":108.745},{"id":"1-72","paragraph":38,"text":"“No, thanks.”","charStart":1768,"charEnd":1781,"start":109.0875,"end":109.845},{"id":"1-73","paragraph":39,"text":"Good.","charStart":1783,"charEnd":1788,"start":110.15,"end":110.52000000000001},{"id":"1-74","paragraph":39,"text":"I can do this.","charStart":1789,"charEnd":1803,"start":110.8125,"end":111.62},{"id":"1-75","paragraph":40,"text":"Maya puts a cup in front of me.","charStart":1805,"charEnd":1836,"start":111.9125,"end":113.33250000000001},{"id":"1-76","paragraph":40,"text":"Then she points to the bucket.","charStart":1837,"charEnd":1867,"start":113.6375,"end":114.95750000000001},{"id":"1-77","paragraph":41,"text":"“The kitchen tap’s broken.","charStart":1869,"charEnd":1895,"start":115.3625,"end":116.57000000000001},{"id":"1-78","paragraph":41,"text":"Someone’s coming tomorrow, between eight and twelve.","charStart":1896,"charEnd":1948,"start":116.8625,"end":119.69500000000001},{"id":"1-79","paragraph":41,"text":"Can you be here?","charStart":1949,"charEnd":1965,"start":119.9875,"end":120.745},{"id":"1-80","paragraph":41,"text":"I’ve got to go to the office.”","charStart":1966,"charEnd":1996,"start":121.0375,"end":122.3575},{"id":"1-81","paragraph":42,"text":"I hear tomorrow.","charStart":1998,"charEnd":2014,"start":122.675,"end":123.50750000000001},{"id":"1-82","paragraph":42,"text":"I hear eight.","charStart":2015,"charEnd":2028,"start":123.8,"end":124.47},{"id":"1-83","paragraph":43,"text":"“Yes,” I say.","charStart":2030,"charEnd":2043,"start":124.8375,"end":125.6575},{"id":"1-84","paragraph":44,"text":"Maya picks up her phone.","charStart":2045,"charEnd":2069,"start":125.95,"end":127.09500000000001},{"id":"1-85","paragraph":45,"text":"“Great.","charStart":2071,"charEnd":2078,"start":127.4625,"end":127.77000000000001},{"id":"1-86","paragraph":45,"text":"Thank you.”","charStart":2079,"charEnd":2090,"start":128.1375,"end":128.60750000000002},{"id":"1-87","paragraph":46,"text":"I look at the bucket.","charStart":2092,"charEnd":2113,"start":128.9125,"end":129.795},{"id":"1-88","paragraph":46,"text":"A drop of water falls into it.","charStart":2114,"charEnd":2144,"start":130.0875,"end":131.7825},{"id":"1-89","paragraph":47,"text":"Then another.","charStart":2146,"charEnd":2159,"start":132.0875,"end":132.745},{"id":"1-90","paragraph":48,"text":"