-106","paragraph":58,"text":"I’m sorry.","charStart":2544,"charEnd":2554,"start":156.425,"end":157.045},{"id":"1-107","paragraph":58,"text":"I have to leave at nine.”","charStart":2555,"charEnd":2580,"start":157.3375,"end":158.495},{"id":"1-108","paragraph":59,"text":"Maya puts her phone down.","charStart":2582,"charEnd":2607,"start":158.8125,"end":160.07},{"id":"1-109","paragraph":60,"text":"“Right.”","charStart":2609,"charEnd":2617,"start":160.4375,"end":160.73250000000002},{"id":"1-110","paragraph":61,"text":"For a moment, neither of us speaks.","charStart":2619,"charEnd":2654,"start":161.15,"end":163.22},{"id":"1-111","paragraph":62,"text":"“I can stay until nine,” I say.","charStart":2656,"charEnd":2687,"start":163.575,"end":165.5575},{"id":"1-112","paragraph":62,"text":"“Is that okay?”","charStart":2688,"charEnd":2703,"start":165.925,"end":166.59500000000003},{"id":"1-113","paragraph":63,"text":"“Not really.","charStart":2705,"charEnd":2717,"start":166.975,"end":167.52},{"id":"1-114","paragraph":63,"text":"He might come later.”","charStart":2718,"charEnd":2739,"start":167.8375,"end":168.75750000000002},{"id":"1-115","paragraph":64,"text":"My face feels hot.","charStart":2741,"charEnd":2759,"start":169.0625,"end":170.1825},{"id":"1-116","paragraph":64,"text":"I look at my tea.","charStart":2760,"charEnd":2777,"start":170.4875,"end":171.33249999999998},{"id":"1-117","paragraph":65,"text":"Then I try another question.","charStart":2779,"charEnd":2807,"start":171.6375,"end":172.8575},{"id":"1-118","paragraph":66,"text":"“Can he come in the afternoon?”","charStart":2809,"charEnd":2840,"start":173.225,"end":174.445},{"id":"1-119","paragraph":67,"text":"Maya looks at her phone.","charStart":2842,"charEnd":2866,"start":174.75,"end":175.87},{"id":"1-120","paragraph":68,"text":"“I don’t know.","charStart":2868,"charEnd":2882,"start":176.2,"end":176.745},{"id":"1-121","paragraph":68,"text":"Let me ask.”","charStart":2883,"charEnd":2895,"start":177.025,"end":177.79500000000002},{"id":"1-122","paragraph":69,"text":"She types a message.","charStart":2897,"charEnd":2917,"start":178,"end":179.10750000000002},{"id":"1-123","paragraph":69,"text":"I move my cup away from the edge of the table.","charStart":2918,"charEnd":2964,"start":179.4,"end":181.63250000000002},{"id":"1-124","paragraph":70,"text":"A minute later, her phone makes a sound.","charStart":2966,"charEnd":3006,"start":181.925,"end":184.17000000000002},{"id":"1-125","paragraph":71,"text":"“Two to four,” she says.","charStart":3008,"charEnd":3032,"start":184.5375,"end":185.7825},{"id":"1-126","paragraph":71,"text":"“I can be home then.”","charStart":3033,"charEnd":3054,"start":186.15,"end":187.0575},{"id":"1-127","paragraph":72,"text":"“So I don’t need to stay?”","charStart":3056,"charEnd":3082,"start":187.4375,"end":188.6825},{"id":"1-128","paragraph":73,"text":"“That’s right.”","charStart":3084,"charEnd":3099,"start":189.075,"end":189.57000000000002},{"id":"1-129","paragraph":74,"text":"“Okay.","charStart":3101,"charEnd":3107,"start":189.95,"end":190.2325},{"id":"1-130","paragraph":74,"text":"Sorry about that.”","charStart":3108,"charEnd":3126,"start":190.5875,"end":191.5575},{"id":"1-131","paragraph":75,"text":"“It’s okay.”","charStart":3128,"charEnd":3140,"start":191.9375,"end":192.4825},{"id":"1-132","paragraph":75,"text":"She picks up her cup.","charStart":3141,"charEnd":3162,"start":192.8,"end":193.78250000000003},{"id":"1-133","paragraph":75,"text":"“Just tell me when you’re not sure.”","charStart":3163,"charEnd":3199,"start":194.1625,"end":195.5325},{"id":"1-134","paragraph":76,"text":"Her phone rings again.","charStart":3201,"charEnd":3223,"start":195.85,"end":196.945},{"id":"1-135","paragraph":77,"text":"“I need to take this.","charStart":3225,"charEnd":3246,"start":197.275,"end":198.1825},{"id":"1-136","paragraph":77,"text":"Make yourself at home.”","charStart":3247,"charEnd":3270,"start":198.475,"end":199.57},{"id":"1-137","paragraph":78,"text":"“Thanks.”","charStart":3272,"charEnd":3281,"start":200.0125,"end":200.42},{"id":"1-138","paragraph":79,"text":"She walks towards her room.","charStart":3283,"charEnd":3310,"start":200.8,"end":202.02},{"id":"1-139","paragraph":80,"text":"I look at the two chairs by the window.","charStart":3312,"charEnd":3351,"start":202.3125,"end":204.095},{"id":"1-140","paragraph":80,"text":"Then I look at the books.","charStart":3352,"charEnd":3377,"start":204.3875,"end":205.445},{"id":"1-141","paragraph":81,"text":"“Maya?”","charStart":3379,"charEnd":3386,"start":205.8125,"end":206.17000000000002},{"id":"1-142","paragraph":82,"text":"“Yes?”","charStart":3388,"charEnd":3394,"start":206.5375,"end":206.9575},{"id":"1-143","paragraph":83,"text":"“Can I move these?”","charStart":3396,"charEnd":3415,"start":207.5,"end":208.4575},{"id":"1-144","paragraph":84,"text":"“Of course.","charStart":3417,"charEnd":3428,"start":208.825,"end":209.42000000000002},{"id":"1-145","paragraph":84,"text":"Put them on the table.”","charStart":3429,"charEnd":3452,"start":209.7375,"end":210.69500000000002},{"id":"1-146","paragraph":85,"text":"I move the books and sit down.","charStart":3454,"charEnd":3484,"start":211.0125,"end":212.51999999999998},{"id":"1-147","paragraph":86,"text":"My tea is still warm.","charStart":3486,"charEnd":3507,"start":212.8125,"end":213.98250000000002}],"translations":{"1-1":"我的包放在门外。","1-2":"我手里拿着手机。","1-3":"4B号公寓。","1-4":"我又核对了一遍门牌号。","1-5":"然后敲了敲门。","1-6":"一位女士打开了门。","1-7":"她一只手里拿着一个蓝色杯子。","1-8":"“Andy？”","1-9":"“对。","1-10":"你好。","1-11":"我是Andy。”","1-12":"“我是Maya。","1-13":"进来吧。”","1-14":"我提起包，跟着她走进去。","1-15":"公寓里飘着咖啡的香味。","1-16":"窗边摆着两把椅子，中间是一张小桌子。","1-17":"其中一把椅子上放着几本书。","1-18":"“不好意思，书还没收，”Maya说。","1-19":"“你的房间在这边。”","1-20":"房间不大，不过有一张书桌。","1-21":"我把包放在床边。","1-22":"“还可以吗？”她问。","1-23":"“对。","1-24":"挺好的。”","1-25":"我还有些事想问。","1-26":"我的食物可以放在哪里？","1-27":"洗衣机能用吗？","1-28":"厨房里为什么有个水桶？","1-29":"但Maya的手机响了。","1-30":"她看了一眼屏幕，把铃声关了。","1-31":"“抱歉。","1-32":"工作电话。”","1-33":"“没关系。”","1-34":"我的包倒在走廊里。","1-35":"一只鞋掉了出来。","1-36":"我们俩都看着那只鞋。","1-37":"“不好意思。”","1-38":"我用脚把鞋拨回包里。","1-39":"“就敞着吧，”她说。","1-40":"“以前我的包在这儿放了一个星期呢。”","1-41":"“你住这儿多久了？”","1-42":"“三年。”","1-43":"我又看了看椅子上那摞书。","1-44":"最上面有幅画，画着公交车上的两个人。","1-45":"一个人靠在另一个人的肩上睡着了。","1-46":"“这是你画的吗？”","1-47":"“是啊。”","1-48":"她这才第一次放下手机。","1-49":"“我正在做一页设计稿，这画是画给那一页的。","1-50":"你看这儿。”","1-51":"她把画转过来。","1-52":"两个人身上是同一件外套。","1-53":"这下我看明白了。","1-54":"一件外套盖着他们两个人。","1-55":"“我喜欢右边那个男的，”我说。","1-56":"“那是我妈。”","1-57":"我又看了一眼。","1-58":"她笑了。","1-59":"“她真有那么一顶帽子。”","1-60":"手机屏幕亮了。","1-61":"Maya看了一眼来电人的名字。","1-62":"这回她拿起了手机。","1-63":"“又是工作的事？”","1-64":"“对。","1-65":"他们想把别人负责的那一页换张图。","1-66":"我的先等等吧。”","1-67":"她合上画册，画里那两个人和那件外套也一起消失了。","1-68":"我们回到厨房。","1-69":"“喝茶吗？”她问。","1-70":"“好，麻烦了。”","1-71":"“加奶吗？”","1-72":"“不加，谢谢。”","1-73":"很好。","1-74":"这些我能应付。","1-75":"Maya把一杯茶放到我面前。","1-76":"接着，她指了指水桶。","1-77":"“厨房水龙头坏了。","1-78":"明天八点到十二点之间会有人来修。","1-79":"你能在家等一下吗？","1-80":"我得去办公室。”","1-81":"我听到了“明天”。","1-82":"我听到了“八点”。","1-83":"“可以，”我说。","1-84":"Maya拿起手机。","1-85":"“太好了。","1-86":"谢谢。”","1-87":"我看着水桶。","1-88":"一滴水落了进去。","1-89":"接着又是一滴。","1-90":"我明天十点有个会。","1-91":"去办公室要四十分钟。","1-92":"也许师傅八点就会来。","1-93":"也许十分钟就能修好。","1-94":"也许我该问清楚。","1-95":"Maya开始打字。","1-96":"“不好意思，”我说。","1-97":"她抬起头。","1-98":"“你能再说一遍吗？","1-99":"具体是几点？”","1-100":"“八点到十二点之间。”","1-101":"“八点到十二点，”我重复道。","1-102":"“也就是说，也可能是十一点？”","1-103":"“对。","1-104":"还没有确切时间。”","1-105":"“哦。","1-106":"不好意思。","1-107":"我九点就得出门。”","1-108":"Maya放下手机。","1-109":"“这样啊。”","1-110":"一时间，我们谁也没说话。","1-111":"“我可以待到九点，”我说。","1-112":"“这样行吗？”","1-113":"“恐怕不行。","1-114":"他可能晚一点才来。”","1-115":"我的脸开始发烫。","1-116":"我低头看着茶。","1-117":"然后试着换个问题。","1-118":"“他能下午来吗？”","1-119":"Maya看了看手机。","1-120":"“不知道。","1-121":"我问问。”","1-122":"她发了一条消息。","1-123":"我把杯子往里挪了挪，离桌边远一点。","1-124":"一分钟后，她的手机响了一声。","1-125":"“两点到四点，”她说。","1-126":"“那时候我能在家。”","1-127":"“那我就不用留下了？”","1-128":"“对。”","1-129":"“好。","1-130":"给你添麻烦了。”","1-131":"“没事。”","1-132":"她拿起杯子。","1-133":"“不确定的时候直接跟我说就好。”","1-134":"她的手机又响了。","1-135":"“这个电话我得接。","1-136":"就当自己家，随意一点。”","1-137":"“谢谢。”","1-138":"她朝自己的房间走去。","1-139":"我看了看窗边的两把椅子。","1-140":"又看了看那些书。","1-141":"“Maya？”","1-142":"“怎么了？”","1-143":"“这些书我可以挪一下吗？”","1-144":"“当然。","1-145":"放桌上就行。”","1-146":"我把书挪开，坐了下来。","1-147":"茶还是温的。"}}
